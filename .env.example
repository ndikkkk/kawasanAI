# Kode yang digunakan pengguna untuk masuk. Ganti dengan nilai rahasia yang kuat.
ACCESS_CODE=ubah-kode-ini
# Opsional: kode login kedua. Kedua kode memiliki izin chat yang sama.
ACCESS_CODE_2=
# Wajib: rahasia acak minimal 32 karakter untuk menandatangani session.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# URL dasar provider yang kompatibel dengan OpenAI.
# Contoh: https://api.example.com/v1
TOKEN_GATEWAY_BASE_URL=https://alamat-token-gateway-kamu/v1
TOKEN_GATEWAY_API_KEY=isi-api-key-di-vercel
# Opsional: default jika request tidak mengirim model dari UI.
TOKEN_GATEWAY_MODEL=gpt-6-astra

# Opsional: instruksi yang selalu diberikan kepada model.
SYSTEM_PROMPT=Kamu adalah asisten AI yang membantu, akurat, dan ramah.